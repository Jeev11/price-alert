# Copy to .env (never commit .env). On a host, set these as environment variables instead.

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Public address of the site, used in email links (no trailing slash)
BASE_URL=http://localhost:5000

# Dedicated Gmail account for the SITE (not your personal one) + its 16-character App Password
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_FROM_NAME=Price Alert

CHECK_INTERVAL_MINUTES=120
MAX_PER_EMAIL=3
MAX_TOTAL_TRACKERS=2000
DATABASE_PATH=data/tracker.db
PRICE_PROVIDER=direct

# 0 only for local http testing; keep 1 in production (HTTPS)
COOKIE_SECURE=0
# 1 when behind a reverse proxy / Cloudflare so rate limits see the real client IP
TRUST_PROXY=0
RUN_SCHEDULER=1
